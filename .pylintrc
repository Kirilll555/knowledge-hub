[MASTER]
# Specify a configuration file
# Pylint will look for configuration in this order:
# 1. --rcfile argument
# 2. ./pylintrc
# 3. ~/.pylintrc
# 4. /etc/pylintrc

# Use multiple processes to speed up Pylint
jobs=4

# List of plugins
load-plugins=pylint_django

# Ignore patterns
ignore=
    migrations,
    __pycache__,
    .venv,
    venv

# Ignore specific file patterns
ignore-patterns=
    ^(.*/)?__pycache__$,
    ^(.*/)?\.venv$

[MESSAGES CONTROL]
disable=
    missing-docstring,
    too-few-public-methods,
    too-many-arguments,
    too-many-instance-attributes,
    line-too-long,
    fixme,
    import-error

[REPORTS]
# Set the output format
output-format=parseable

# Maximum number of locals for function / method body
max-locals=15

# Maximum number of branches for function / method body
max-branches=12

# Maximum number of arguments for function / method
max-args=5

# Maximum number of attributes for a class
max-attributes=7

[FORMAT]
# Maximum number of characters on a single line
max-line-length=120

# Indent string
indent-string='    '

# Number of spaces of indent required inside a hanging or continued line
indent-after-paren=4

[DESIGN]
# Maximum number of public methods for a class
max-public-methods=20

[VARIABLES]
# Good variable names which should always be accepted, separated by a comma
good-names=
    i,j,k,
    ex,Run,_,
    id,x,y,z,
    f,df,
    db,pk,

[LOGGING]
# Format of logging format string
logging-format-style=old

[SIMILARITIES]
# Minimum lines number d a duplicate code block must have to be considered a duplicate
min-similarity-lines=4

# Ignore comments and docstrings when computing similarities
ignore-comments=yes

ignore-docstrings=yes

[SPELLING]
# Spelling dictionary name
spelling-dict=en_US

[TYPECHECK]
# List of decorators that produce context managers
contextmanager-decorators=contextlib.contextmanager

[STRING_CONSTANT]
# This flag controls whether the implicit-str-concat-single-line should be triggered
check-quote-consistency=yes
